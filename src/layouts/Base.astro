---
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;  // e.g. "/" or "/werk/"
  robots?: string;
  noCanonical?: boolean;
  ogType?: 'website' | 'article';
  autoBreadcrumb?: boolean; // false when the page/layout emits its own BreadcrumbList
}
const {
  title,
  description = 'Dutch Torque Service. Professionele kalibratie en service van momentsleutels',
  canonicalPath,
  robots = 'index, follow',
  noCanonical = false,
  ogType = 'website',
  autoBreadcrumb = true,
} = Astro.props;

const siteBase = 'https://www.dutchtorqueservice.nl';

/** Absolute www URL with a trailing slash (home is siteBase + "/"). */
function absoluteUrl(path?: string): string {
  if (!path || path === '/') return `${siteBase}/`;
  const withSlash = path.startsWith('/') ? path : `/${path}`;
  return siteBase + (withSlash.endsWith('/') ? withSlash : `${withSlash}/`);
}

const canonicalURL = absoluteUrl(canonicalPath ?? '/');
const ogImage = `${siteBase}/og-image.jpg`;
const ogImageAlt = 'Dutch Torque Service, Precisie op elk moment. Momentsleutel kalibratie, reparatie en certificering, Riethoven, Noord-Brabant';

// BreadcrumbList for every page except home, unless the page emits its own.
const crumbNames: Record<string, string> = {
  'diensten': 'Diensten',
  'momentsleutel-kalibratie': 'Momentsleutel kalibratie',
  'momentsleutel-reparatie': 'Momentsleutel reparatie',
  'momentsleutel-justeren': 'Momentsleutel justeren',
  'iso-6789-certificering': 'ISO 6789 certificering',
  'blog': 'Blog',
  'contact': 'Contact',
  'faq': 'Veelgestelde vragen',
  'werk': 'Ons werk',
  'over-ons': 'Over ons',
  'privacy': 'Privacybeleid',
};
const crumbPath = new URL(canonicalURL).pathname;
const crumbSegments = crumbPath.split('/').filter(Boolean);
const breadcrumbSchema = (autoBreadcrumb && !noCanonical && crumbSegments.length > 0 && robots.startsWith('index'))
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteBase}/` },
        ...crumbSegments.map((seg, i) => ({
          "@type": "ListItem",
          "position": i + 2,
          "name": crumbNames[seg] ?? seg,
          "item": `${siteBase}/${crumbSegments.slice(0, i + 1).join('/')}/`,
        })),
      ],
    }
  : null;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": "https://www.dutchtorqueservice.nl/#business",
  "name": "Dutch Torque Service",
  "legalName": "Dutch Torque Service",
  "description": "Professionele momentsleutel kalibratie, reparatie en ISO 6789:2017 en 2003 certificering. \u00b12% servicegarantie, ruim binnen de ISO 6789 tolerantie van \u00b14%.",
  "url": "https://www.dutchtorqueservice.nl/",
  "logo": "https://www.dutchtorqueservice.nl/logo/dts-logo-2x.webp",
  "image": ogImage,
  "telephone": "+31613172774",
  "email": "info@dutchtorqueservice.nl",
  "identifier": {
    "@type": "PropertyValue",
    "name": "KvK",
    "propertyID": "ChamberOfCommerceNumber",
    "value": "67183360"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Tonterstraat 42",
    "addressLocality": "Riethoven",
    "postalCode": "5561 AN",
    "addressCountry": "NL",
    "addressRegion": "Noord-Brabant"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 51.34915,
    "longitude": 5.38555
  },
  "areaServed": [
    { "@type": "Country", "name": "Netherlands" },
    { "@type": "Country", "name": "Belgium" },
    { "@type": "Country", "name": "Germany" },
    { "@type": "AdministrativeArea", "name": "Noord-Brabant" }
  ],
  "serviceType": [
    "Momentsleutel reparatie",
    "Momentsleutel justeren",
    "Momentsleutel kalibratie",
    "ISO 6789 certificering"
  ],
  "knowsAbout": [
    "ISO 6789:2017 en 2003",
    "ISO 6789-1",
    "ISO 6789-2",
    "Momentsleutel kalibratie",
    "Type I momentsleutels (indicerend)",
    "Type II momentsleutels (instellend)",
    "Snap-On momentsleutels",
    "Traceerbare referentieapparatuur"
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ],
  "inLanguage": "nl-NL",
  "foundingDate": "2026-01-01",
  "employee": { "@id": "https://www.dutchtorqueservice.nl/#jan-piet-schulte" },
  "sameAs": [
    "https://www.kvk.nl/zoeken/?source=all&q=67183360",
    "https://www.linkedin.com/company/dutch-torque-service"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.dutchtorqueservice.nl/#website",
  "url": "https://www.dutchtorqueservice.nl/",
  "name": "Dutch Torque Service",
  "description": "Specialist in momentsleutel kalibratie, reparatie en certificering conform ISO 6789:2017 en 2003",
  "inLanguage": "nl-NL",
  "publisher": { "@id": "https://www.dutchtorqueservice.nl/#business" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".hero-subtitle", ".sec-sub", ".article-lead", ".faq-answer"]
  }
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.dutchtorqueservice.nl/#jan-piet-schulte",
  "name": "Jan-Piet Schulte",
  "jobTitle": "Eigenaar & Kalibratietechnicus",
  "worksFor": { "@id": "https://www.dutchtorqueservice.nl/#business" },
  "url": "https://www.dutchtorqueservice.nl/over-ons/",
  "inLanguage": "nl-NL",
  "knowsAbout": [
    "ISO 6789:2017 en 2003 kalibratie",
    "Type I en Type II momentsleutels",
    "Snap-On momentsleutels",
    "Traceerbare referentieapparatuur",
    "Kalibratieprotocollen voor ISO 9001, IATF 16949 en VCA"
  ]
};
---
<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08090B" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Dutch Torque Service" />
    <meta name="geo.region" content="NL-NB" />
    <meta name="geo.placename" content="Riethoven, Noord-Brabant" />

    {(!noCanonical) && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content="Dutch Torque Service" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>

    <!-- Fonts: Inter Variable is self-hosted via @fontsource-variable/inter (imported in the
         layout frontmatter). One variable woff2 replaces seven separate weights, no third-party
         request (GDPR-safe), no render-blocking external stylesheet, font-display: swap built in. -->

    <!-- Structured data. LocalBusiness + WebSite + Person -->
    <script type="application/ld+json" set:html={JSON.stringify([localBusinessSchema, websiteSchema, personSchema])} />

    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    <!-- Per-page structured data slot -->
    <slot name="head" />
  </head>
  <body>
    <!-- Skip link, allows keyboard users to jump past nav directly to content -->
    <a href="#main-content" class="skip-link">Ga naar inhoud</a>
    <!-- Skip-link target: invisible anchor placed before page content -->
    <div id="main-content" tabindex="-1" style="outline:none;"></div>
    <slot />
    <style>
      .skip-link {
        position:    absolute;
        left:        1rem;
        top:         -3rem;
        z-index:     9999;
        padding:     0.5rem 1.25rem;
        border-radius: 0 0 8px 8px;
        background:  #7AAFC4;
        color:       #08090B;
        font-size:   0.8125rem;
        font-weight: 700;
        text-decoration: none;
        transition:  top 0.2s ease;
      }
      .skip-link:focus { top: 0; }
    </style>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReduced) {
        // Global scroll-reveal, fromTo so GSAP owns both states explicitly
        document.querySelectorAll('[data-animate]').forEach((el) => {
          const delay = parseFloat((el as HTMLElement).dataset.animateDelay ?? '0');
          const dir   = (el as HTMLElement).dataset.animateFrom ?? 'bottom';

          const fromVars: Record<string, unknown> = { opacity: 0 };
          const toVars:   Record<string, unknown> = { opacity: 1, duration: 0.85, delay, ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 96%',
              toggleActions: 'play none none none',
              once: true,
            }
          };

          if (dir === 'bottom') { fromVars.y = 40; toVars.y = 0; toVars.clearProps = 'transform'; }
          if (dir === 'left')   { fromVars.x = -40; toVars.x = 0; toVars.clearProps = 'transform'; }
          if (dir === 'right')  { fromVars.x = 40;  toVars.x = 0; toVars.clearProps = 'transform'; }
          if (dir === 'scale')  { fromVars.scale = 0.94; toVars.scale = 1; toVars.clearProps = 'transform'; }

          gsap.fromTo(el, fromVars, toVars);
        });

        // Fire triggers for elements already in view on load
        ScrollTrigger.refresh();
      }
    </script>
  </body>
</html>
