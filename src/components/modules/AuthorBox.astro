---
/**
 * AuthorBox — short technician/expertise panel for service pages.
 *
 * The copy is fixed by the growth brief: no credentials, photo or review claim
 * beyond the visible text below.
 */
import PageSection from '../ui/PageSection.astro';
---

<PageSection>
  <aside class="author-box" aria-labelledby="author-box-title" data-animate>
    <div class="author-box__rule" aria-hidden="true"></div>
    <div class="author-box__body">
      <p class="author-box__eyebrow">Dutch Torque Service · Riethoven</p>
      <h2 class="author-box__title" id="author-box-title">Over de technicus</h2>
      <p class="author-box__text">
        Jan-Piet Schulte is kalibratietechnicus bij Dutch Torque Service in Riethoven. Lees meer over het lab, de meetapparatuur en de werkwijze.
      </p>
      <a class="author-box__link" href="/over-ons/">Over Dutch Torque Service →</a>
    </div>
  </aside>
</PageSection>

<style>
  .author-box {
    position: relative;
    display: flex;
    gap: 1.5rem;
    max-width: 820px;
    margin-inline: auto;
    padding: 2rem 2.25rem;
    border-radius: 1.25rem;
    background: linear-gradient(140deg, rgba(122, 175, 196, 0.06) 0%, transparent 60%), #0E1118;
    border: 1px solid rgba(122, 175, 196, 0.22);
    overflow: hidden;
  }

  .author-box__rule {
    flex: 0 0 3px;
    align-self: stretch;
    border-radius: 2px;
    background: linear-gradient(to bottom, transparent, #7AAFC4, transparent);
    opacity: 0.8;
  }

  .author-box__body {
    min-width: 0;
  }

  .author-box__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #7AAFC4;
  }

  .author-box__title {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .author-box__text {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.8;
    color: #9AAEB8;
  }

  .author-box__link {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: #7AAFC4;
    text-decoration: none;
    border-bottom: 1px solid rgba(122, 175, 196, 0.35);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .author-box__link:hover,
  .author-box__link:focus-visible {
    color: #B8D8E8;
    border-color: rgba(184, 216, 232, 0.7);
  }

  @media (max-width: 640px) {
    .author-box {
      padding: 1.5rem 1.35rem;
      gap: 1rem;
    }
  }
</style>
