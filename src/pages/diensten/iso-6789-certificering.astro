---
import Base from '../../layouts/Base.astro';
import NavIsland from '../../components/modules/NavIsland.astro';
import FooterDTS from '../../components/modules/FooterDTS.astro';
import AuthorBox from '../../components/modules/AuthorBox.astro';
import PageSection from '../../components/ui/PageSection.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#webpage",
      "url": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering",
      "name": "Kalibratiecertificaat momentsleutel | traceerbaar, ISO 6789",
      "inLanguage": "nl-NL",
      "author": {
        "@id": "https://www.dutchtorqueservice.nl/#jan-piet-schulte"
      },
      "publisher": {
        "@id": "https://www.dutchtorqueservice.nl/#business"
      },
      "mainEntity": [
        {
          "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#service"
        },
        {
          "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#faq"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#service",
      "name": "Kalibratiecertificaat momentsleutel",
      "provider": {
        "@id": "https://www.dutchtorqueservice.nl/#business"
      },
      "description": "Kalibratiecertificaat (conformiteitsverklaring) voor momentsleutels volgens DIN EN ISO 6789-1:2017, met meetwaarden en traceerbare referentieapparatuur. Voor werkplaatsen en bedrijven die werken onder ISO 9001, IATF 16949 of VCA.",
      "url": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering",
      "areaServed": [
        { "@type": "Country", "name": "Netherlands" },
        { "@type": "Country", "name": "Belgium" },
        { "@type": "Country", "name": "Germany" }
      ],
      "inLanguage": "nl-NL"
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#faq",
      "inLanguage": "nl-NL",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wat is een kalibratie test?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Een kalibratietest is een gedocumenteerde meting van je momentsleutel tegen traceerbare referentieapparatuur. Op het kalibratiecertificaat (de conformiteitsverklaring) staan de methode, de meetpunten, de uitlezingen, de afwijking en de aanbevolen volgende kalibratiedatum. Daarvan is DIN EN ISO 6789-1:2017 een voorbeeld: drie meetpunten met vijf metingen per punt, rechtsom en linksom. Dit is geen wettelijke ijk: voor momentsleutels geldt ijken niet."
          }
        },
        {
          "@type": "Question",
          "name": "Moet een momentsleutel gekalibreerd worden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Je hebt een kalibratiecertificaat nodig als jouw kwaliteitssysteem of opdrachtgever om traceerbaar bewijs vraagt, bijvoorbeeld onder ISO 9001, IATF 16949 of VCA. ISO 6789 schrijft geen vaste geldigheidsduur voor; dat staat in jouw eigen kwaliteitshandboek. In de praktijk staat op het certificaat een aanbevolen volgende kalibratiedatum, meestal een jaar later. Na een val of overbelasting laat je de sleutel opnieuw kalibreren, ook als die datum nog niet is bereikt."
          }
        },
        {
          "@type": "Question",
          "name": "Welke momentsleutel heb ik nodig?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wij certificeren Type I (aanwijzend) en Type II (instellend) momentsleutels. Het voorbeeld op deze pagina gaat uit van een Type I, Klasse C, volgens DIN EN ISO 6789-1:2017. We kalibreren onder meer Snap-On, Stahlwille, Gedore, Facom, Hazet en Würth, en andere gangbare kwaliteitsmerken. Welk type jouw sleutel is, lees je in onze uitleg over ISO 6789 Type I en Type II; wij verkopen zelf geen nieuwe gereedschappen."
          }
        },
        {
          "@type": "Question",
          "name": "Wat kost kalibreren van een momentsleutel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hebben geen openbare prijslijst. De prijs hangt af van het type, het merk en van het werk dat nodig is; reparatie of justering doen we alleen als het nodig is, en alleen na jouw akkoord. Stuur ons een bericht voor een prijsopgave, we reageren binnen één werkdag."
          }
        }
      ]
    }
  ]
};

const certFields = [
  { label: 'Documenttype', value: 'Conformiteitsverklaring / Declaration of Conformance (voorbeelddocument)' },
  { label: 'Testmethode', value: 'DIN EN ISO 6789-1:2017' },
  { label: 'Gereedschap', value: 'Type I momentsleutel, meetbereik 20–200 N·m' },
  { label: 'Type / klasse', value: 'Type I: aanwijzend, Klasse C' },
  { label: 'Serienummer', value: '000000 - VOORBEELD' },
  { label: 'Identificatie-nr. en tester', value: 'Voorbeeldvelden; geen echte namen of nummers' },
  { label: 'Aanpassing', value: 'Leeg' },
  { label: 'Afwijking (toetsing op het formulier)', value: '1,5 %' },
  { label: 'Meetpunten', value: 'Drie: 20 N·m (minimum), 120 N·m (60 %), 200 N·m (100 %)' },
  { label: 'Metingen', value: 'Vijf per punt, rechtsom en linksom' },
  { label: 'Max. afwijking', value: '+1,20 % (ok)' },
  { label: 'Referentieapparatuur', value: 'Traceerbare transducer en kalibratie-inrichting (specificaties staan op het certificaat)' },
  { label: 'Omstandigheden', value: '21,0 °C, luchtvochtigheid 50 %' },
  { label: 'Kalibratiedatum', value: '1 maart 2026 (voorbeeld)' },
  { label: 'Volgende kalibratie', value: '1 maart 2027 (voorbeeld)' },
];

const applySteps = [
  { n: '1', html: 'Stuur de sleutel stevig ingepakt naar, of lever hem in bij: Dutch Torque Service, Tonterstraat 42, 5561 AN Riethoven.' },
  { n: '2', html: '<a href="/diensten/momentsleutel-reparatie">Reparatie</a> of <a href="/diensten/momentsleutel-justeren">justering</a> doen we alleen als het nodig is, en alleen na jouw akkoord.' },
  { n: '3', html: 'Na afronding ontvang je het kalibratiecertificaat.' },
];

const faq = [
  {
    q: 'Wat is een kalibratie test?',
    a: 'Een kalibratietest is een gedocumenteerde meting van je momentsleutel tegen traceerbare referentieapparatuur. Op het kalibratiecertificaat (de conformiteitsverklaring) staan de methode, de meetpunten, de uitlezingen, de afwijking en de aanbevolen volgende kalibratiedatum. Daarvan is DIN EN ISO 6789-1:2017 een voorbeeld: drie meetpunten met vijf metingen per punt, rechtsom en linksom. Dit is geen wettelijke ijk: voor momentsleutels geldt ijken niet. Zie <a href="/blog/verschil-kalibreren-justeren-ijken">kalibreren, justeren of ijken</a>.',
  },
  {
    q: 'Moet een momentsleutel gekalibreerd worden?',
    a: 'Je hebt een kalibratiecertificaat nodig als jouw kwaliteitssysteem of opdrachtgever om traceerbaar bewijs vraagt, bijvoorbeeld onder ISO 9001, IATF 16949 of VCA. ISO 6789 schrijft geen vaste geldigheidsduur voor; dat staat in jouw eigen kwaliteitshandboek. In de praktijk staat op het certificaat een aanbevolen volgende kalibratiedatum, meestal een jaar later. Na een val of overbelasting laat je de sleutel opnieuw kalibreren, ook als die datum nog niet is bereikt. Zie <a href="/blog/hoe-vaak-momentsleutel-kalibreren">hoe vaak je een momentsleutel moet laten kalibreren</a>.',
  },
  {
    q: 'Welke momentsleutel heb ik nodig?',
    a: 'Wij certificeren Type I (aanwijzend) en Type II (instellend) momentsleutels. Het voorbeeld op deze pagina gaat uit van een Type I, Klasse C, volgens DIN EN ISO 6789-1:2017. We kalibreren onder meer Snap-On, Stahlwille, Gedore, Facom, Hazet en Würth, en andere gangbare kwaliteitsmerken. Welk type jouw sleutel is, lees je in <a href="/blog/iso-6789-type-1-type-2-uitgelegd">ISO 6789 Type I en Type II uitgelegd</a>; wij verkopen zelf geen nieuwe gereedschappen.',
  },
  {
    q: 'Wat kost kalibreren van een momentsleutel?',
    a: 'We hebben geen openbare prijslijst. De prijs hangt af van het type, het merk en van het werk dat nodig is; reparatie of justering doen we alleen als het nodig is, en alleen na jouw akkoord. Stuur ons een bericht voor een prijsopgave, we reageren binnen één werkdag. Meer uitleg: <a href="/blog/wat-kost-momentsleutel-kalibreren/">wat kost momentsleutel kalibreren</a>.',
  },
];

const stripTags = (s) => s.replace(/<[^>]+>/g, '');
const faqPage = schema['@graph'].find((n) => n['@type'] === 'FAQPage');
faqPage.mainEntity = faq.map(({ q, a }) => ({
  "@type": "Question",
  "name": q,
  "acceptedAnswer": { "@type": "Answer", "text": stripTags(a) },
}));
---

<Base
  title="Kalibratiecertificaat momentsleutel | traceerbaar, ISO 6789"
  description="Kalibratiecertificaat voor je momentsleutel volgens ISO 6789:2017, met echte meetwaarden. Bruikbaar voor ISO 9001, IATF 16949 en VCA. Lab in Riethoven."
  canonicalPath="/diensten/iso-6789-certificering"
  ogImage="/og/iso.jpg"
  ogImageAlt="Dutch Torque Service: kalibratiecertificaat volgens ISO 6789:2017 en 2003, met as-found- en as-left-waarden."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <NavIsland currentPage="diensten" />

  <main>

    <PageSection class="hero-section">
        <div class="hero-inner">
          <div class="sec-eyebrow" data-animate>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Certificering</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>

          <h1 class="hero-h1" data-animate data-animate-delay="0.08">
            Kalibratiecertificaat voor je momentsleutel.
          </h1>

          <p class="hero-subtitle" data-animate data-animate-delay="0.16">
            Je krijgt van ons een kalibratiecertificaat (conformiteitsverklaring) voor je momentsleutel, opgesteld volgens DIN EN ISO 6789-1:2017, met de echte meetwaarden op het document. Een certificaat bevat drie meetpunten (minimum, circa 60% en 100% van het bereik), vijf metingen per punt, rechtsom en linksom, de toetsingsafwijking en een aanbevolen volgende kalibratiedatum.
          </p>

          <div class="hero-ctas" data-animate data-animate-delay="0.22">
            <a href="/contact" class="btn btn-primary">Neem contact op</a>
            <a href="/diensten/momentsleutel-kalibratie" class="btn btn-outline">Momentsleutel laten kalibreren</a>
          </div>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Uitleg</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title" id="wat-is-een-kalibratiecertificaat">Wat is een kalibratiecertificaat voor een momentsleutel?</h2>
        </div>

        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Een kalibratiecertificaat voor je momentsleutel is een conformiteitsverklaring: het document met de echte meetwaarden, de gevolgde methode en een aanbevolen volgende kalibratiedatum.</p>
          <p class="body-text">Dat is het bewijs dat je aan een auditor of opdrachtgever kunt laten zien. Geen samenvatting alleen: op het <a href="#wat-staat-er-in-een-dts-certificaat">voorbeeld hieronder</a> staan de uitlezingen zelf, gemeten tegen traceerbare referentieapparatuur.</p>
          <p class="body-text">Een “kalibratietest” is precies die gedocumenteerde meting. Het is geen wettelijke ijk: voor momentsleutels geldt ijken niet. Het verschil tussen kalibreren, justeren en ijken staat in onze <a href="/blog/verschil-kalibreren-justeren-ijken">kennisbank</a>.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Rekenvoorbeeld</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title" id="wat-staat-er-in-een-dts-certificaat">Wat staat er in een kalibratiecertificaat?</h2>
        </div>

        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Op een kalibratiecertificaat kun je de meting helemaal volgen: instrumentgegevens, drie meetpunten met vijf uitlezingen per punt, de toetsingsafwijking, de referentieapparatuur met haar eigen vervaldatum, en de volgende kalibratiedatum.</p>
          <p class="body-text">De tabel hieronder toont een fictief voorbeeld van die velden. De waarden zijn willekeurig gekozen en horen niet bij een echte klant of een echt uitgegeven certificaat.</p>
        </div>

        <div class="table-wrap" data-animate data-animate-delay="0.12" id="asset-voorbeeld">
          <table class="incl-table">
            <thead>
              <tr>
                <th>Veld</th>
                <th>Voorbeeldwaarde</th>
              </tr>
            </thead>
            <tbody>
              {certFields.map(row => (
                <tr>
                  <td class="row-label">{row.label}</td>
                  <td>{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="body-text table-source" data-animate>Fictief voorbeeld. De waarden zijn willekeurig gekozen om de velden te tonen; ze zijn niet afkomstig van een klant of een echt certificaat.</p>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Verplichting</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Moet een momentsleutel gekalibreerd worden?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">ISO 6789 schrijft geen vaste geldigheidsduur voor; of je een kalibratiecertificaat nodig hebt, bepaalt jouw kwaliteitshandboek of je opdrachtgever.</p>
          <p class="body-text">Er is geen algemene wettelijke plicht om een momentsleutel te laten kalibreren. Meer daarover staat in <a href="/blog/hoe-vaak-momentsleutel-kalibreren">hoe vaak je een momentsleutel moet laten kalibreren</a>.</p>
          <p class="body-text">Je hebt dit momentsleutelcertificaat wél nodig als je werkt onder ISO 9001, IATF 16949 of VCA, of als een klant om traceerbaar bewijs vraagt.</p>
          <p class="body-text">In het rekenvoorbeeld is de volgende kalibratie een jaar later. Na een val of overbelasting laat je de sleutel opnieuw kalibreren, ook als die datum nog niet is bereikt. Zie ook <a href="/blog/momentsleutel-gevallen-wat-nu">Momentsleutel gevallen, wat nu?</a>.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Doelgroep</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Wie heeft dit certificaat nodig?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Dit kalibratiecertificaat is voor werkplaatsen en bedrijven die audit-proof bewijs nodig hebben van hun momentsleutels — onder meer organisaties die werken onder ISO 9001, IATF 16949 of VCA, in Nederland, België en <a href="/de/drehmomentschluessel-kalibrierung/">Duitsland</a>.</p>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <h2 class="sec-title">Waar kan ik terecht voor gecertificeerde kalibratie?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Voor gecertificeerde kalibratie van momentsleutels kun je terecht bij Dutch Torque Service in Riethoven. Je krijgt een conformiteitsverklaring volgens DIN EN ISO 6789-1:2017, nodig als je werkt onder ISO 9001, IATF 16949 of VCA. Je stuurt de sleutel op of levert hem af; op locatie kalibreren we niet. We reageren binnen één werkdag met een prijsopgave.</p>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Instrumenttypen</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Type I of Type II: welke sleutel certificeren wij?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Wij certificeren Type I (aanwijzend) en Type II (instellend) momentsleutels; het voorbeeld op deze pagina gaat uit van een Type I, Klasse C, volgens DIN EN ISO 6789-1:2017.</p>
          <p class="body-text">Welk type jouw sleutel is, en wat dat voor de kalibratie betekent, lees je in <a href="/blog/iso-6789-type-1-type-2-uitgelegd">ISO 6789 Type I en Type II uitgelegd</a>.</p>
          <p class="body-text">We kalibreren onder meer Snap-On, Stahlwille, Gedore, Facom, Hazet en Würth, en andere gangbare kwaliteitsmerken. We verkopen geen nieuwe gereedschappen; dit is geen koopwijzer.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Aanvragen</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Hoe vraag je een kalibratiecertificaat aan?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Je stuurt de momentsleutel in, of je brengt hem langs in ons lab in <a href="/diensten/momentsleutel-kalibratie-noord-brabant/">Riethoven</a>. We kalibreren niet op locatie.</p>
          <ol class="apply-steps">
            {applySteps.map(step => (
              <li>
                <span class="apply-n">{step.n}</span>
                <span set:html={step.html} />
              </li>
            ))}
          </ol>
          <p class="body-text">Openingstijden van het lab: maandag t/m vrijdag 08:00–17:00 (Europe/Amsterdam). Contact: <a href="tel:+31613172774">+31 6 131 72 774</a>, <a href="mailto:info@dutchtorqueservice.nl">info@dutchtorqueservice.nl</a>.</p>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Prijs</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Wat kost het kalibreren van een momentsleutel?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">We publiceren geen prijslijst; stuur ons een bericht voor een prijsopgave, we reageren binnen één werkdag.</p>
          <p class="body-text">De prijs hangt af van het type, het merk en van het werk dat nodig is. Reparatie of justering alleen als het nodig is, en alleen na jouw akkoord. Meer uitleg: <a href="/blog/wat-kost-momentsleutel-kalibreren/">wat kost momentsleutel kalibreren</a>.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Van de technicus</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Wat ik zelf op dit certificaat belangrijk vind</h2>
        </div>
        <blockquote class="author-card" data-animate data-animate-delay="0.08">
          <p>Ik wil dat je op het certificaat precies kunt zien wat je sleutel doet, niet alleen een stempel dat hij “voldoet”. Op dit voorbeeld staat de toetsingsafwijking op 2,0% — dat is onze servicegarantie — en je ziet per meetpunt de vijf uitlezingen, rechtsom en linksom, met de maximale afwijking eronder als ok. Dat is het papier dat je bij een audit op tafel legt.</p>
          <footer>— Jan-Piet Schulte, eigenaar en kalibratietechnicus</footer>
        </blockquote>
    </PageSection>

    <AuthorBox />

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">FAQ</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
