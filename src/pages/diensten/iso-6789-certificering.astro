---
import Base from '../../layouts/Base.astro';
import NavIsland from '../../components/modules/NavIsland.astro';
import FooterDTS from '../../components/modules/FooterDTS.astro';
import PageSection from '../../components/ui/PageSection.astro';
import { Image } from 'astro:assets';
import certP1 from '../../img/certificates/sample-certificate-redacted-p1-1400.webp';
import certP2 from '../../img/certificates/sample-certificate-redacted-p2-1400.webp';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#webpage",
      "url": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering",
      "name": "Kalibratiecertificaat momentsleutel | traceerbaar, ISO 6789",
      "inLanguage": "nl-NL",
      "author": {
        "@id": "https://www.dutchtorqueservice.nl/#jan-piet-schulte"
      },
      "publisher": {
        "@id": "https://www.dutchtorqueservice.nl/#business"
      },
      "mainEntity": [
        {
          "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#service"
        },
        {
          "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#faq"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#service",
      "name": "Kalibratiecertificaat momentsleutel",
      "provider": {
        "@id": "https://www.dutchtorqueservice.nl/#business"
      },
      "description": "Kalibratiecertificaat (conformiteitsverklaring) voor momentsleutels volgens DIN EN ISO 6789-1:2017, met meetwaarden en traceerbare referentieapparatuur. Voor werkplaatsen en bedrijven die werken onder ISO 9001, IATF 16949 of VCA.",
      "url": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering",
      "areaServed": [
        { "@type": "Country", "name": "Netherlands" },
        { "@type": "Country", "name": "Belgium" },
        { "@type": "Country", "name": "Germany" }
      ],
      "inLanguage": "nl-NL"
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering#faq",
      "inLanguage": "nl-NL",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wat is een kalibratie test?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Een kalibratietest is een gedocumenteerde meting van je momentsleutel tegen traceerbare referentieapparatuur. Op het kalibratiecertificaat (de conformiteitsverklaring) staan de methode, de meetpunten, de uitlezingen, de afwijking en de aanbevolen volgende kalibratiedatum. Op het voorbeeldcertificaat is dat DIN EN ISO 6789-1:2017, drie meetpunten met vijf metingen per punt, rechtsom en linksom. Dit is geen wettelijke ijk: voor momentsleutels geldt ijken niet."
          }
        },
        {
          "@type": "Question",
          "name": "Moet een momentsleutel gekalibreerd worden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Je hebt een kalibratiecertificaat nodig als jouw kwaliteitssysteem of opdrachtgever om traceerbaar bewijs vraagt, bijvoorbeeld onder ISO 9001, IATF 16949 of VCA. ISO 6789 schrijft geen vaste geldigheidsduur voor; dat staat in jouw eigen kwaliteitshandboek. Op het voorbeeldcertificaat van 4 november 2026 is de volgende kalibratie 4 november 2027. Na een val of overbelasting laat je de sleutel opnieuw kalibreren, ook als die datum nog niet is bereikt."
          }
        },
        {
          "@type": "Question",
          "name": "Welke momentsleutel heb ik nodig?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wij certificeren Type I (aanwijzend) en Type II (instellend) momentsleutels. Het voorbeeldcertificaat is een Type I, Klasse C, volgens DIN EN ISO 6789-1:2017. We kalibreren onder meer Snap-On, Stahlwille, Gedore, Facom, Hazet en Würth, en andere gangbare kwaliteitsmerken. Welk type jouw sleutel is, lees je in onze uitleg over ISO 6789 Type I en Type II; wij verkopen zelf geen nieuwe gereedschappen."
          }
        },
        {
          "@type": "Question",
          "name": "Wat kost kalibreren van een momentsleutel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hebben geen openbare prijslijst. De prijs hangt af van het type, het merk en van het werk dat nodig is; reparatie of justering doen we alleen als het nodig is, en alleen na jouw akkoord. Stuur ons een bericht voor een prijsopgave, we reageren binnen één werkdag."
          }
        }
      ]
    }
  ]
};

const certFields = [
  { label: 'Documenttype', value: 'Conformiteitsverklaring / Declaration of Conformance, nrs. 669 en 670' },
  { label: 'Testmethode', value: 'DIN EN ISO 6789-1:2017' },
  { label: 'Gereedschap', value: 'Momentsleutel, Milwaukee 481162 R-L, meetbereik 16,9–203 N·m' },
  { label: 'Type / klasse', value: 'Type I: aanwijzend, Klasse C' },
  { label: 'Serienummer', value: '000185 - A2025 (nr. 669) en 000205 - A2025 (nr. 670) — twee verschillende sleutels' },
  { label: 'Identificatie-nr. en tester', value: 'Deze velden staan op het formulier en zijn ingevuld; op de afbeeldingen zwart gemaakt' },
  { label: 'Aanpassing', value: 'Leeg op beide pagina’s' },
  { label: 'Afwijking (toetsing op het formulier)', value: '2,0 %' },
  { label: 'Meetpunten', value: 'Drie: 16,9 N·m (minimum), 122 N·m (60,01 %), 203 N·m (100,00 %)' },
  { label: 'Metingen', value: 'Vijf per punt, rechtsom en linksom' },
  { label: 'Max. afwijking', value: 'Nr. 669: −2,00 % (ok); nr. 670: 1,55 % (ok)' },
  { label: 'Referentieapparatuur', value: 'Transducer 7728-40 (40–400 N·m, 520270037, tot 8 juni 2030) en 7728-6 (6–60 N·m, 520070286, tot 8 juni 2030); kalibratie-inrichting 7791; software Torkmaster 5.1.3.1' },
  { label: 'Omstandigheden', value: '21,0 °C, luchtvochtigheid 50,0 %' },
  { label: 'Kalibratiedatum', value: '4 november 2026 (11:48:32 en 13:02:46)' },
  { label: 'Volgende kalibratie', value: '4 november 2027' },
];

const applySteps = [
  { n: '1', html: 'Stuur de sleutel stevig ingepakt naar, of lever hem in bij: Dutch Torque Service, Tonterstraat 42, 5561 AN Riethoven.' },
  { n: '2', html: 'De diagnose is gratis.' },
  { n: '3', html: '<a href="/diensten/momentsleutel-reparatie">Reparatie</a> of <a href="/diensten/momentsleutel-justeren">justering</a> doen we alleen als het nodig is, en alleen na jouw akkoord.' },
  { n: '4', html: 'Na afronding ontvang je het kalibratiecertificaat.' },
];

const faq = [
  {
    q: 'Wat is een kalibratie test?',
    a: 'Een kalibratietest is een gedocumenteerde meting van je momentsleutel tegen traceerbare referentieapparatuur. Op het kalibratiecertificaat (de conformiteitsverklaring) staan de methode, de meetpunten, de uitlezingen, de afwijking en de aanbevolen volgende kalibratiedatum. Op het voorbeeldcertificaat is dat DIN EN ISO 6789-1:2017, drie meetpunten met vijf metingen per punt, rechtsom en linksom. Dit is geen wettelijke ijk: voor momentsleutels geldt ijken niet. Zie <a href="/blog/verschil-kalibreren-justeren-ijken">kalibreren, justeren of ijken</a>.',
  },
  {
    q: 'Moet een momentsleutel gekalibreerd worden?',
    a: 'Je hebt een kalibratiecertificaat nodig als jouw kwaliteitssysteem of opdrachtgever om traceerbaar bewijs vraagt, bijvoorbeeld onder ISO 9001, IATF 16949 of VCA. ISO 6789 schrijft geen vaste geldigheidsduur voor; dat staat in jouw eigen kwaliteitshandboek. Op het voorbeeldcertificaat van 4 november 2026 is de volgende kalibratie 4 november 2027. Na een val of overbelasting laat je de sleutel opnieuw kalibreren, ook als die datum nog niet is bereikt. Zie <a href="/blog/hoe-vaak-momentsleutel-kalibreren">hoe vaak je een momentsleutel moet laten kalibreren</a>.',
  },
  {
    q: 'Welke momentsleutel heb ik nodig?',
    a: 'Wij certificeren Type I (aanwijzend) en Type II (instellend) momentsleutels. Het voorbeeldcertificaat is een Type I, Klasse C, volgens DIN EN ISO 6789-1:2017. We kalibreren onder meer Snap-On, Stahlwille, Gedore, Facom, Hazet en Würth, en andere gangbare kwaliteitsmerken. Welk type jouw sleutel is, lees je in <a href="/blog/iso-6789-type-1-type-2-uitgelegd">ISO 6789 Type I en Type II uitgelegd</a>; wij verkopen zelf geen nieuwe gereedschappen.',
  },
  {
    q: 'Wat kost kalibreren van een momentsleutel?',
    a: 'We hebben geen openbare prijslijst. De prijs hangt af van het type, het merk en van het werk dat nodig is; reparatie of justering doen we alleen als het nodig is, en alleen na jouw akkoord. Stuur ons een bericht voor een prijsopgave, we reageren binnen één werkdag.',
  },
];
---

<Base
  title="Kalibratiecertificaat momentsleutel | traceerbaar, ISO 6789"
  description="Kalibratiecertificaat (conformiteitsverklaring) voor je momentsleutel volgens DIN EN ISO 6789-1:2017, met de echte meetwaarden. Lab in Riethoven."
  canonicalPath="/diensten/iso-6789-certificering"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <NavIsland currentPage="diensten" />

  <main>

    <PageSection class="hero-section">
        <div class="hero-inner">
          <div class="sec-eyebrow" data-animate>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Certificering</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>

          <h1 class="hero-h1" data-animate data-animate-delay="0.08">
            Kalibratiecertificaat voor je momentsleutel.
          </h1>

          <p class="hero-subtitle" data-animate data-animate-delay="0.16">
            Je krijgt van ons een kalibratiecertificaat (conformiteitsverklaring) voor je momentsleutel, opgesteld volgens DIN EN ISO 6789-1:2017, met de echte meetwaarden op het document. Op het voorbeeldcertificaat staan drie meetpunten (minimum, circa 60% en 100% van het bereik), vijf metingen per punt, rechtsom en linksom, een toetsingsafwijking van 2,0% en een aanbevolen volgende kalibratiedatum.
          </p>

          <div class="hero-ctas" data-animate data-animate-delay="0.22">
            <a href="/contact" class="btn btn-primary">Neem contact op</a>
            <a href="/diensten/momentsleutel-kalibratie" class="btn btn-outline">Momentsleutel laten kalibreren</a>
          </div>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Uitleg</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title" id="wat-is-een-kalibratiecertificaat">Wat is een kalibratiecertificaat voor een momentsleutel?</h2>
        </div>

        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Een kalibratiecertificaat voor je momentsleutel is een conformiteitsverklaring: het document met de echte meetwaarden, de gevolgde methode en een aanbevolen volgende kalibratiedatum.</p>
          <p class="body-text">Dat is het bewijs dat je aan een auditor of opdrachtgever kunt laten zien. Geen samenvatting alleen: op het <a href="#wat-staat-er-in-een-dts-certificaat">voorbeeld hieronder</a> staan de uitlezingen zelf, gemeten tegen traceerbare referentieapparatuur.</p>
          <p class="body-text">Een “kalibratietest” is precies die gedocumenteerde meting. Het is geen wettelijke ijk: voor momentsleutels geldt ijken niet. Het verschil tussen kalibreren, justeren en ijken staat in onze <a href="/blog/verschil-kalibreren-justeren-ijken">kennisbank</a>.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Voorbeeldcertificaat</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title" id="wat-staat-er-in-een-dts-certificaat">Wat staat er in een DTS-certificaat?</h2>
        </div>

        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Op het voorbeeldcertificaat kun je de meting helemaal volgen: instrumentgegevens, drie meetpunten met vijf uitlezingen per punt, de toetsingsafwijking, de transducers met hun eigen vervaldatum, en de volgende kalibratiedatum.</p>
          <p class="body-text">De tabel en de afbeeldingen hieronder beschrijven dit document: twee conformiteitsverklaringen van 4 november 2026, voor twee verschillende momentsleutels.</p>
        </div>

        <div class="table-wrap" data-animate data-animate-delay="0.12" id="asset-669">
          <table class="incl-table">
            <thead>
              <tr>
                <th>Veld</th>
                <th>Op het voorbeeldcertificaat</th>
              </tr>
            </thead>
            <tbody>
              {certFields.map(row => (
                <tr>
                  <td class="row-label">{row.label}</td>
                  <td>{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="body-text table-source" data-animate>Bron van de hele tabel: voorbeeldcertificaat van 4 november 2026 (geredigeerde weergave hieronder).</p>

        <figure class="cert-figure" data-animate>
          <Image
            src={certP1}
            alt="Voorbeeld DTS-conformiteitsverklaring 669, 4 november 2026. Milwaukee 481162 R-L, Type I Klasse C, DIN EN ISO 6789-1:2017. Identificatienummer en naam van de tester zijn zwart gemaakt."
            widths={[700, 1000, 1400]}
            sizes="(min-width: 900px) 820px, 100vw"
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="cert-image"
          />
          <figcaption>Voorbeeldcertificaat, pagina 1: Conformiteitsverklaring 669 (4 november 2026). Milwaukee 481162 R-L, Type I: aanwijzend, Klasse C, methode DIN EN ISO 6789-1:2017. Drie meetpunten (16,9 / 122 / 203 N·m) met vijf metingen per punt, rechtsom en linksom. Max. afwijking −2,00 %, beoordeeld als ok. Volgende kalibratie 4 november 2027. Het identificatienummer en de naam van de tester zijn zwart gemaakt.</figcaption>
        </figure>

        <figure class="cert-figure" data-animate>
          <Image
            src={certP2}
            alt="Voorbeeld DTS-conformiteitsverklaring 670, 4 november 2026. Zelfde type momentsleutel, ander serienummer. Identificatienummer en naam van de tester zijn zwart gemaakt."
            widths={[700, 1000, 1400]}
            sizes="(min-width: 900px) 820px, 100vw"
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="cert-image"
          />
          <figcaption>Voorbeeldcertificaat, pagina 2: Conformiteitsverklaring 670, dezelfde dag, een tweede momentsleutel (serienummer 000205 - A2025), geen voor-en-nameting van dezelfde sleutel. Zelfde methode, dezelfde drie meetpunten en vijf metingen per punt. Max. afwijking 1,55 %, beoordeeld als ok. Ook hier zijn het identificatienummer en de naam van de tester zwart gemaakt.</figcaption>
        </figure>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Verplichting</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Moet een momentsleutel gekalibreerd worden?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">ISO 6789 schrijft geen vaste geldigheidsduur voor; of je een kalibratiecertificaat nodig hebt, bepaalt jouw kwaliteitshandboek of je opdrachtgever.</p>
          <p class="body-text">Er is geen algemene wettelijke plicht om een momentsleutel te laten kalibreren. Meer daarover staat in <a href="/blog/hoe-vaak-momentsleutel-kalibreren">hoe vaak je een momentsleutel moet laten kalibreren</a>.</p>
          <p class="body-text">Je hebt dit momentsleutelcertificaat wél nodig als je werkt onder ISO 9001, IATF 16949 of VCA, of als een klant om traceerbaar bewijs vraagt.</p>
          <p class="body-text">Op het voorbeeldcertificaat van 4 november 2026 staat als volgende kalibratie 4 november 2027 — een jaar later. Na een val of overbelasting laat je de sleutel opnieuw kalibreren, ook als die datum nog niet is bereikt. Zie ook <a href="/blog/momentsleutel-gevallen-wat-nu">Momentsleutel gevallen, wat nu?</a>.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Doelgroep</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Wie heeft dit certificaat nodig?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Dit kalibratiecertificaat is voor werkplaatsen en bedrijven die audit-proof bewijs nodig hebben van hun momentsleutels — onder meer organisaties die werken onder ISO 9001, IATF 16949 of VCA, in Nederland, België en Duitsland.</p>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Instrumenttypen</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Type I of Type II: welke sleutel certificeren wij?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Wij certificeren Type I (aanwijzend) en Type II (instellend) momentsleutels; het voorbeeldcertificaat is een Type I, Klasse C, volgens DIN EN ISO 6789-1:2017.</p>
          <p class="body-text">Welk type jouw sleutel is, en wat dat voor de kalibratie betekent, lees je in <a href="/blog/iso-6789-type-1-type-2-uitgelegd">ISO 6789 Type I en Type II uitgelegd</a>.</p>
          <p class="body-text">We kalibreren onder meer Snap-On, Stahlwille, Gedore, Facom, Hazet en Würth, en andere gangbare kwaliteitsmerken. We verkopen geen nieuwe gereedschappen; dit is geen koopwijzer.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Aanvragen</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Hoe vraag je een kalibratiecertificaat aan?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">Je stuurt de momentsleutel in, of je brengt hem langs in ons lab in Riethoven. We kalibreren niet op locatie.</p>
          <ol class="apply-steps">
            {applySteps.map(step => (
              <li>
                <span class="apply-n">{step.n}</span>
                <span set:html={step.html} />
              </li>
            ))}
          </ol>
          <p class="body-text">Openingstijden van het lab: maandag t/m vrijdag 08:00–17:00 (Europe/Amsterdam). Contact: <a href="tel:+31613172774">+31 6 131 72 774</a>, <a href="mailto:info@dutchtorqueservice.nl">info@dutchtorqueservice.nl</a>.</p>
        </div>
    </PageSection>

    <PageSection>
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Prijs</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Wat kost het kalibreren van een momentsleutel?</h2>
        </div>
        <div class="def-card" data-animate data-animate-delay="0.08">
          <p class="body-lead">We publiceren geen prijslijst; stuur ons een bericht voor een prijsopgave, we reageren binnen één werkdag.</p>
          <p class="body-text">De prijs hangt af van het type, het merk en van het werk dat nodig is. Reparatie of justering alleen als het nodig is, en alleen na jouw akkoord.</p>
        </div>
    </PageSection>

    <PageSection class="[background:rgba(14,17,24,0.5)]">
        <div class="sec-head" data-animate>
          <div class="sec-eyebrow">
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
            <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">Van de technicus</span>
            <span class="w-8 h-px opacity-75" style="background:#7AAFC4; display:inline-block;"></span>
          </div>
          <h2 class="sec-title">Wat ik zelf op dit certificaat belangrijk vind</h2>
        </div>
        <blockquote class="author-card" data-animate data-animate-delay="0.08">
