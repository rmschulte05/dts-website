---
import Base from '../../layouts/Base.astro';
import NavIsland from '../../components/modules/NavIsland.astro';
import FooterDTS from '../../components/modules/FooterDTS.astro';
import PageSection from '../../components/ui/PageSection.astro';

const pageUrl = 'https://www.dutchtorqueservice.nl/en/torque-wrench-calibration/';
const nlUrl = 'https://www.dutchtorqueservice.nl/diensten/momentsleutel-kalibratie/';

const faq = [
  {
    q: 'Do you publish torque wrench calibration prices?',
    a: 'No. We do not publish a price list. The price depends on the type of torque wrench, the brand, and the work required. Repair or adjustment is only done if needed, and only after you agree. You will receive a quote within one working day.',
  },
  {
    q: 'Do you offer on-site or mobile torque wrench calibration?',
    a: 'No. You send the torque wrench in or bring it to our laboratory in Riethoven, the Netherlands. We do not calibrate on site.',
  },
  {
    q: 'Which brands do you service?',
    a: 'Among others Snap-On, Stahlwille, Gedore, Facom, Hazet and Würth, and other common quality brands. We also service hydraulic and high-torque industrial tools. Dutch Torque Service is not a dealer and does not sell new tools.',
  },
];

const stripTags = (s) => s.replace(/<[^>]+>/g, '');
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": stripTags(a) },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Torque wrench calibration in the Netherlands",
  "serviceType": "Torque wrench calibration",
  "url": pageUrl,
  "inLanguage": "en-GB",
  "description": "Send-in torque wrench calibration in Riethoven, the Netherlands, according to ISO 6789:2017 and 2003, with a calibration certificate. ±2% service guarantee, within the ISO 6789 tolerance of ±4%. Quote within one working day.",
  "provider": { "@id": "https://www.dutchtorqueservice.nl/#business" },
  "areaServed": [
    { "@type": "Country", "name": "Netherlands" },
    { "@type": "Country", "name": "Belgium" },
    { "@type": "Country", "name": "Germany" }
  ],
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceLocation": { "@id": "https://www.dutchtorqueservice.nl/#business" },
    "serviceUrl": pageUrl
  }
};

const hreflang = [
  { lang: 'en', href: pageUrl },
  { lang: 'nl', href: nlUrl },
  { lang: 'de', href: 'https://www.dutchtorqueservice.nl/de/drehmomentschluessel-kalibrierung/' },
  { lang: 'x-default', href: 'https://www.dutchtorqueservice.nl/' },
];
---

<Base
  title="Torque wrench calibration in the Netherlands | DTS"
  description="Torque wrench calibration in the Netherlands. ISO 6789:2017 and 2003 certificate, ±2% service guarantee. Quote within one working day. Lab in Riethoven."
  canonicalPath="/en/torque-wrench-calibration/"
  htmlLang="en"
  ogLocale="en_GB"
  ogLocaleAlternate={['nl_NL', 'de_DE']}
  hreflang={hreflang}
  skipLinkLabel="Skip to content"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <NavIsland currentPage="en" />

  <main>
    <PageSection hero center animate>
      <div class="sec-eyebrow">
        <span class="w-8 h-px opacity-75" style="background:#7AAFC4;"></span>
        <span class="text-[11px] font-semibold tracking-[0.32em] uppercase" style="color:#7AAFC4;">English</span>
        <span class="w-8 h-px opacity-75" style="background:#7AAFC4;"></span>
      </div>
      <h1 class="font-black tracking-tight text-white" style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05;">
        Torque wrench calibration in the Netherlands.
      </h1>
      <p class="sec-sub">
        Send your torque wrench in, or visit our laboratory in Riethoven, Noord-Brabant. We diagnose, repair, adjust and calibrate to ISO 6789:2017 and 2003, and issue a calibration certificate. No on-site service.
      </p>
      <div class="en-ctas" data-animate data-animate-delay="0.16">
        <a href="mailto:info@dutchtorqueservice.nl" class="btn btn-primary">Request a quote</a>
        <a href="tel:+31613172774" class="btn btn-outline">Call +31 6 131 72 774</a>
      </div>
    </PageSection>

    <PageSection>
      <div class="en-wrap" data-animate>
        <h2 class="sec-title" style="margin-bottom: 1.25rem;">What we do</h2>
        <p>Dutch Torque Service is a family business in Riethoven, run by Jan-Piet Schulte (owner and calibration technician) and his sons. Since 1 January 2026, DTS has continued this work after taking over the workshop equipment from Van Rootselaar Technic bv. in Stiens.</p>
        <p>We diagnose, repair, adjust (justeren) and calibrate torque wrenches, and issue a calibration certificate according to ISO 6789:2017 and 2003 (Type I and Type II). We also service hydraulic and high-torque industrial tools.</p>
        <p>Calibration is carried out over the full range, with multiple measurements per point. The certificate includes as-found and as-left values, the traceable reference equipment used, and a recommended next interval. You receive the certificate by email. Our service guarantee is ±2%, within the ISO 6789 tolerance of ±4%.</p>
        <p>Repair or adjustment is only done if needed, and only after you agree.</p>
      </div>
    </PageSection>

    <PageSection>
      <div class="en-wrap" data-animate>
        <h2 class="sec-title" style="margin-bottom: 1.25rem;">How to arrange a calibration</h2>
        <p>Email <a href="mailto:info@dutchtorqueservice.nl">info@dutchtorqueservice.nl</a>, call <a href="tel:+31613172774">+31 6 131 72 774</a>, or use the <a href="/contact/">contact form</a> (Dutch). You will receive a quote within one working day. There is no price list online; the price depends on the type of torque wrench, the brand, and the work required.</p>
        <p>Send the wrench in or bring it to the laboratory:</p>
        <p><strong>Dutch Torque Service</strong><br />Tonterstraat 42<br />5561 AN Riethoven<br />The Netherlands</p>
        <p>Opening hours: Monday to Friday, 08:00–17:00. We serve workshops and companies in the Netherlands, Belgium and Germany, including those working under quality systems such as ISO 9001, IATF 16949 or VCA. We do not claim RvA or ISO/IEC 17025 accreditation.</p>
        <p>Brands we service include Snap-On, Stahlwille, Gedore, Facom, Hazet and Würth, and other common quality brands. We are not a dealer and we do not sell new tools.</p>
        <p>A more detailed packing and shipping guide is on our Dutch page <a href="/blog/momentsleutel-opsturen-voor-kalibratie/">Momentsleutel opsturen voor kalibratie</a>. The Dutch service page for this work is <a href="/diensten/momentsleutel-kalibratie/">Momentsleutel laten kalibreren</a>. This page is also available in German: <a href="/de/drehmomentschluessel-kalibrierung/">Drehmomentschlüssel kalibrieren</a>. The rest of this website is in Dutch.</p>
      </div>
    </PageSection>

    <PageSection>
      <div class="en-wrap" data-animate>
        <h2 class="sec-title" style="margin-bottom: 1.25rem;">Frequently asked questions</h2>
        {faq.map((item) => (
          <details class="en-faq">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </PageSection>
  </main>

  <FooterDTS />
</Base>

<style>
  .en-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .en-wrap {
    max-width: 760px;
    margin-inline: auto;
  }
  .en-wrap p,
  .en-faq p {
    font-size: 0.975rem;
    line-height: 1.8;
    color: #8EAAB8;
    margin-bottom: 1rem;
  }
  .en-wrap a {
    color: #7AAFC4;
    text-decoration: underline;
  }
  .en-wrap strong {
    color: #E8F0F4;
    font-weight: 600;
  }
  .en-faq {
    background: #0E1118;
    border: 1px solid rgba(122,175,196,0.14);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }
  .en-faq summary {
    cursor: pointer;
    color: #E8F0F4;
    font-weight: 600;
    list-style: none;
  }
  .en-faq summary::-webkit-details-marker { display: none; }
  .en-faq[open] summary { margin-bottom: 0.75rem; }
  .en-faq p { margin-bottom: 0; }
</style>
