---
import Base from '../layouts/Base.astro';
import WrenchBackground from '../components/modules/WrenchBackground.astro';
import NavIsland from '../components/modules/NavIsland.astro';
import HeroDTS from '../components/modules/HeroDTS.astro';
import AboutSnippet from '../components/modules/AboutSnippet.astro';
import Services from '../components/modules/Services.astro';
import CoreValues from '../components/modules/CoreValues.astro';
import FooterDTS from '../components/modules/FooterDTS.astro';

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Diensten Dutch Torque Service",
  "inLanguage": "nl-NL",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Momentsleutel reparatie",
      "description": "Volledig herstel van momentsleutels, van Snap-On tot Stahlwille",
      "url": "https://www.dutchtorqueservice.nl/diensten/momentsleutel-reparatie"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Momentsleutel Justeren",
      "description": "Herinstelling op juiste Newton-meterwaarden na slijtage of val",
      "url": "https://www.dutchtorqueservice.nl/diensten/momentsleutel-justeren"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Momentsleutel Kalibratie",
      "description": "Professionele kalibratie volgens ISO 6789:2017 en 2003 over het hele bereik, met meerdere metingen per punt",
      "url": "https://www.dutchtorqueservice.nl/diensten/momentsleutel-kalibratie"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "ISO 6789:2017 en 2003 Certificering",
      "description": "Officieel kalibratiecertificaat, audit-proof voor gecertificeerde bedrijven",
      "url": "https://www.dutchtorqueservice.nl/diensten/iso-6789-certificering"
    }
  ]
};
---

<Base
  title="Momentsleutel kalibratie ISO 6789 | Dutch Torque Service"
  description="Momentsleutel kalibratie en ISO 6789:2017 en 2003 certificering. ±2% servicegarantie binnen ±4% ISO-tolerantie. Lab in Riethoven, voor NL, BE en DE."
  canonicalPath="/"
  ogImage="/og/home.jpg"
  ogImageAlt="Dutch Torque Service: Precisie op elk moment. Momentsleutel kalibratie, reparatie en certificering in Riethoven."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />

  <!-- Fixed background layer: wrench stays put while page scrolls -->
  <WrenchBackground />

  <NavIsland currentPage="home" />

  <main>
    <HeroDTS />
    <AboutSnippet />
    <Services
      bodies={{
        repareren: 'Alleen bij mechanische schade: demontage, reiniging en vervanging van slijtdelen, pas na jouw akkoord. Geen schade? Dan slaan we deze stap over. Bij mechanische schade repareren we slijtdelen en kalibreren we de sleutel daarna opnieuw.',
        kalibreren: 'Gedocumenteerde meting volgens ISO 6789:2017 en 2003 over het volledige bereik (as-left na de ingreep). Meerdere metingen per punt, traceerbare referentieapparatuur. Laat je momentsleutel kalibreren volgens ISO 6789:2017 en 2003, met de gemeten waarden op het certificaat.',
        certificeren: 'ISO 6789:2017 en 2003 certificaat met as-found en as-left waarden, gebruikte referentieapparatuur en aanbevolen interval. Audit-proof. Voor je audit krijg je een certificaat met de as-found- en as-left waarden, bruikbaar onder ISO 9001, IATF 16949 en VCA.',
      }}
      linkLabels={{
        repareren: 'Momentsleutel repareren',
        kalibreren: 'Momentsleutel laten kalibreren',
        certificeren: 'ISO 6789-kalibratiecertificaat',
      }}
    />
    <CoreValues />
  </main>

  <FooterDTS />

</Base>
